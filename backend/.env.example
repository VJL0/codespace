# App
ENVIRONMENT=development
APP_URL=http://localhost:5173
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codespace

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email: sent with Resend in production, logged everywhere else
RESEND_API_KEY=
EMAIL_FROM=CodeSpace <no-reply@codespace.example.com>

# Secrets: signing the OAuth flow cookie, and keying rate-limit buckets.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_SESSION_SECRET_KEY=
RATE_LIMIT_SECRET_KEY=
