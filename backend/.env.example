# App
ENVIRONMENT=development
# The one public origin: the SPA at / and this API at /api. Locally that's
# Vite, which proxies /api to uvicorn on :8000.
APP_URL=http://localhost:5173

# HTTP
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Local Postgres
POSTGRES_DB=codespace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codespace

# Google OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OIDC
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the temporary OAuth session cookie.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_SESSION_SECRET_KEY=